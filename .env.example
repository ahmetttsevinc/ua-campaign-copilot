DATABASE_URL=postgres://copilot:copilot@localhost:5432/copilot
TEST_DATABASE_URL=postgres://copilot:copilot@localhost:5432/copilot_test
API_PORT=3001

LLM_PROVIDER=anthropic            # anthropic | nebius | fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5      # cheap default; claude-sonnet-5-5 for higher quality
ANTHROPIC_EFFORT=low

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507   # tool-calling capable, $0.20/$0.60 per 1M

JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-haiku-5-5

LLM_TIMEOUT_MS=60000
MAX_RETRIES=3

AGENT_MAX_STEPS=10
AGENT_MAX_TOKENS=120000
AGENT_MAX_WALL_MS=90000
TOOL_TIMEOUT_MS=5000

ATTRIBUTION_FAILURE_RATE=0.1
ATTRIBUTION_LATENCY_MS_MIN=200
ATTRIBUTION_LATENCY_MS_MAX=800
# ATTRIBUTION_BASE_URL defaults to http://127.0.0.1:$API_PORT/mock/attribution

KILL_AFTER_STEP=                  # dev only, simulates a crash
