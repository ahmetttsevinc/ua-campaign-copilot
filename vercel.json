{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @copilot/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [{ "source": "/api/:path*", "destination": "https://ua-copilot-api.onrender.com/:path*" }]
}
