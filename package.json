{
  "name": "ua-campaign-copilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @copilot/api --filter @copilot/web dev",
    "dev:api": "pnpm --filter @copilot/api dev",
    "dev:web": "pnpm --filter @copilot/web dev",
    "db:generate": "pnpm --filter @copilot/api db:generate",
    "db:migrate": "pnpm --filter @copilot/api db:migrate",
    "db:seed": "pnpm --filter @copilot/api db:seed",
    "db:reset": "pnpm --filter @copilot/api db:reset",
    "tool": "pnpm --silent --filter @copilot/api tool",
    "ask": "pnpm --silent --filter @copilot/api ask",
    "test": "pnpm -r --if-present test",
    "e2e": "pnpm --filter @copilot/web e2e",
    "eval": "pnpm --filter @copilot/evals eval",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
