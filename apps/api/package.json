{
  "name": "@copilot/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed/seed.ts",
    "db:reset": "tsx --env-file-if-exists=../../.env src/db/reset.ts && pnpm db:migrate && pnpm db:seed",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "tool": "tsx --env-file-if-exists=../../.env src/cli/tool.ts",
    "ask": "tsx --env-file-if-exists=../../.env src/cli/ask.ts",
    "start": "tsx src/db/migrate.ts && tsx src/db/seed/seed.ts && tsx src/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@copilot/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "openai": "^7.47.0",
    "postgres": "~3.4.9",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.0.5"
  }
}
